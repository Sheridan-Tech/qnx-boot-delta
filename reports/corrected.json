    "sources": {
      "baseline.build": "# Original illustrative QNX 8 startup fragment, not a bootable BSP.\n# The referenced executables are not distributed with this project.\n[+script] telemetry-startup = {\n    display_msg \"Starting the telemetry console\"\n    MODE=production\n    [pri=20f] devc-ser8250 -e -b 115200 0x3f8,4 &\n    waitfor /dev/ser1 5.0\n    reopen /dev/ser1 2.0\n    [pri=10r +critical] telemetry-agent --device /dev/ser1 &\n    waitfor /dev/telemetry 3.0\n    [+session] ksh &\n}\n"
    },
    "input": "baseline.build",
